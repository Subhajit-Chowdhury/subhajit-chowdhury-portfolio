# GEMINI_API_KEY: Required for Gemini AI API calls.
# In AI Studio, this is injected as GEMINI_API_KEY.
# For Vercel/Netlify/Local Vite, use VITE_GEMINI_API_KEY.
# For the local assistant backend, set the local server URL here.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_ASSISTANT_API_URL=http://localhost:4000
